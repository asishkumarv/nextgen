{
  "expo": {
    "name": "Go Fixit Vendor",
    "slug": "gofixit-vendor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/GoFixit.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/GoFixit.png",
      "resizeMode": "contain",
      "backgroundColor": "#312C51"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gofixit.vendor"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/GoFixit.png",
        "backgroundColor": "#312C51"
      },
      "package": "com.gofixit.vendor",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./src/assets/GoFixit.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6d0b7ceb-3b3c-4abe-98ad-bbbb8ef11616"
      }
    }
  }
}
